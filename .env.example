# Runtime profile: dev or prod
APP_ENVIRONMENT=dev
APP_LOG_LEVEL=INFO

# OpenAI-compatible API. Keep the real key only in .env or a secret store.
APP_LLM_BASE_URL=https://api.openai.com/v1
APP_LLM_API_KEY=
APP_LLM_MODEL=gpt-4o-mini
APP_LLM_CONNECT_TIMEOUT_SECONDS=5
APP_LLM_READ_TIMEOUT_SECONDS=30
APP_LLM_RETRIES=2
APP_LLM_RETRY_BACKOFF_SECONDS=0.25

APP_CACHE_TTL_SECONDS=300
APP_CACHE_MAX_ENTRIES=1024
APP_PROMPT_VERSION=v1

